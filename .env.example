# Variáveis do docker-compose. Copie para .env na raiz (ignorado pelo git).
# Só é necessário se algum default conflitar com a sua máquina.

# Porta em que o Postgres do compose fica exposto no host.
# Troque se você já tem um Postgres rodando na 5432.
POSTGRES_PORT=5432

# Chave de assinatura do JWT usada pelo container do backend.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-trocar-em-producao-min-32-chars
