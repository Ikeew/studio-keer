# Copie para .env e ajuste. O .env NÃO vai para o git.

# Conexão com o Postgres. Use o driver psycopg (v3), não psycopg2.
# Rodando fora do docker-compose, troque `db` por `localhost`.
DATABASE_URL=postgresql+psycopg://keer:keer@localhost:5432/keer

# Chave de assinatura do JWT. Mínimo 32 caracteres.
# Gere uma real com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# NUNCA reutilize esta de exemplo em produção.
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-de-no-minimo-32-caracteres

ENVIRONMENT=local
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
TIMEZONE=America/Sao_Paulo
